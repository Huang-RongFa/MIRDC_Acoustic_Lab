# Run from the repository root after building frontend/dist.
# CNC_SITE_ADDRESS must be a DNS name pointing to this server.
{$CNC_SITE_ADDRESS} {
    tls internal
    @external not remote_ip {$ACOUSTIC_PROXY_NETWORKS:private_ranges}
    respond @external "不允許此網路存取" 403
    handle /ws/* {
        reverse_proxy 127.0.0.1:8015
    }
    encode zstd gzip
    header {
        Permissions-Policy "microphone=(self)"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8015
    }
    handle {
        root * frontend/dist
        try_files {path} /index.html
        file_server
    }
}
